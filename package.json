{
  "name": "mockket",
  "version": "0.1.0",
  "private": true,
  "description": "Live esports market simulator using fake money and real market prices.",
  "scripts": {
    "test": "node tests/roguelike.test.js && node tests/http-smoke.js",
    "migrate:run-history": "node ensure-run-history.js",
    "start": "node ensure-run-history.js && node -r ./settlement-tuning-runtime.js -r ./run-history-runtime.js -r ./game-loop-runtime.js server.js",
    "dev": "node --env-file=.env ensure-run-history.js && node --env-file=.env -r ./settlement-tuning-runtime.js -r ./run-history-runtime.js -r ./game-loop-runtime.js server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
